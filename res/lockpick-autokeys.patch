 	emu_cfg.enabled = !h_cfg.emummc_force_disable;
 
+	// Ryazhenka: consume the request before dumping, then return without prompts.
+	if (!f_stat("bootloader/sys/autokeys.request", NULL))
+	{
+		f_unlink("bootloader/sys/autokeys.request");
+		autokeys_silent = true;
+		dump_keys();
+		// Mark completion only after this invocation saved the console's key set.
+		if (autokeys_saved)
+			sd_save_to_file("2.0.1-97c2755-v1", sizeof("2.0.1-97c2755-v1") - 1,
+				"bootloader/sys/autokeys.version");
+		launch_payload("bootloader/update.bin", false);
+		autokeys_silent = false; // Chainloading may fail; keep the manual menu usable.
+	}
+
 	// Grey out emummc option if not present.
 	if (h_cfg.emummc_force_disable)
 	{
diff --git a/source/storage/nx_sd.c b/source/storage/nx_sd.c
index f2cec2f..0550728 100644
--- a/source/storage/nx_sd.c
+++ b/source/storage/nx_sd.c
@@ -226,8 +226,12 @@ int sd_save_to_file(void *buf, u32 size, const char *filename)
 		return res;
 	}
 
-	f_write(&fp, buf, size, NULL);
-	f_close(&fp);
-
-	return 0;
+	UINT written = 0;
+	res = f_write(&fp, buf, size, &written);
+	FRESULT closed = f_close(&fp);
+	if (res)
+		return res;
+	if (written != size)
+		return FR_DISK_ERR;
+	return closed;
 }
